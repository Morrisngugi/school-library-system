# ==============================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================
# This file is used when running with Docker in development mode
# Command: docker-compose -f docker-compose.dev.yml up

# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ==============================================
# Database Configuration (Docker)
# ==============================================
# MongoDB connection (using Docker service name)
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/school_library?authSource=admin

# ==============================================
# JWT Configuration
# ==============================================
# Use a simple secret for development (CHANGE IN PRODUCTION!)
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ==============================================
# Email Configuration
# ==============================================
# For development, you can use your Gmail or use a service like Mailtrap
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ngugimorry@gmail.com
EMAIL_PASSWORD=onfo idrm lmbe iykk
EMAIL_FROM=noreply@schoollibrary.com
EMAIL_FROM_NAME=School Library Dev

# ==============================================
# SMS Configuration (Africa's Talking - Kenya)
# ==============================================
# For development, you can use sandbox credentials
# Sign up at: https://africastalking.com/
SMS_API_KEY=your_sandbox_api_key
SMS_USERNAME=sandbox
SMS_SENDER_ID=LIBRARY

# ==============================================
# File Upload Configuration
# ==============================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# ==============================================
# Pagination Defaults
# ==============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ==============================================
# Library Policies
# ==============================================
MAX_BOOKS_PER_USER=3
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=10
MAX_RENEWAL_TIMES=2

# ==============================================
# Client URL (Frontend)
# ==============================================
CLIENT_URL=http://localhost:3000

# ==============================================
# Admin Default Credentials (Development Only)
# ==============================================
ADMIN_EMAIL=admin@schoollibrary.com
ADMIN_PASSWORD=admin123

# ==============================================
# Debug Options
# ==============================================
DEBUG=true
LOG_LEVEL=debug
