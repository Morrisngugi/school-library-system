# .gitignore for School Library Management System

# Environment files (never commit these!)
.env
.env.local
.env.development.local
.env.production.local
backend/.env

# Keep example files
!.env.example
!.env.development
!.env.production

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build outputs
backend/build/
frontend/dist/
frontend/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Uploads
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Database backups
*.sql
database_backups/
backup/
backup-*/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Test coverage
coverage/
.nyc_output/

# Docker
.dockerignore

# Temporary files
tmp/
temp/
*.tmp

# MacOS
.AppleDouble
.LSOverride

# Windows
[Dd]esktop.ini
$RECYCLE.BIN/

# MongoDB
data/
dump/
