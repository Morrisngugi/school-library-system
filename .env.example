# ==============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================
# Copy this file to create your environment-specific files:
# - For Docker Development: Use .env.development
# - For Docker Production: Use .env.production  
# - For Manual Setup: Copy to backend/.env

# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ==============================================
# Database Configuration
# ==============================================
# For Docker: mongodb://admin:admin123@mongodb:27017/school_library?authSource=admin
# For Local: mongodb://localhost:27017/school_library
MONGODB_URI=mongodb://localhost:27017/school_library
MONGODB_TEST_URI=mongodb://localhost:27017/school_library_test

# ==============================================
# JWT Configuration
# ==============================================
# ⚠️ Generate a strong secret for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ==============================================
# Email Configuration (Nodemailer)
# ==============================================
# Gmail example (requires App Password with 2FA enabled)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@schoollibrary.com
EMAIL_FROM_NAME=School Library

# ==============================================
# SMS Configuration (Africa's Talking - Kenya)
# ==============================================
# Sign up at: https://africastalking.com/
# For testing, use sandbox mode
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username
SMS_SENDER_ID=LIBRARY

# ==============================================
# File Upload
# ==============================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# ==============================================
# Pagination
# ==============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ==============================================
# Library Policies
# ==============================================
MAX_BOOKS_PER_USER=3
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=10
MAX_RENEWAL_TIMES=2

# ==============================================
# Client URL (Frontend)
# ==============================================
CLIENT_URL=http://localhost:3000

# ==============================================
# Admin Default Credentials
# ==============================================
ADMIN_EMAIL=admin@schoollibrary.com
ADMIN_PASSWORD=admin123
