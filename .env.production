# ==============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# This file is used when running with Docker in production mode
# Command: docker-compose up

# ⚠️ IMPORTANT: Update all values below before deploying to production!

# ==============================================
# Server Configuration
# ==============================================
NODE_ENV=production
PORT=5000
API_VERSION=v1

# ==============================================
# Database Configuration (Docker)
# ==============================================
# MongoDB connection (using Docker service name)
MONGODB_URI=mongodb://admin:CHANGE_THIS_PASSWORD@mongodb:27017/school_library?authSource=admin

# ==============================================
# JWT Configuration
# ==============================================
# ⚠️ CRITICAL: Generate a strong secret key!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=de344f3d21ecb71e0de6a3c0f11c2b0215547b5fcf981fa354de85b1d2e6d2a3
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ==============================================
# Email Configuration
# ==============================================
# ⚠️ IMPORTANT: Update with your production email credentials
# For Gmail: Enable 2FA and create App Password
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ngugimorry@gmail.com
EMAIL_PASSWORD=onfo idrm lmbe iykk
EMAIL_FROM=noreply@schoollibrary.com
EMAIL_FROM_NAME=School Library System

# ==============================================
# SMS Configuration (Africa's Talking - Kenya)
# ==============================================
# ⚠️ IMPORTANT: Update with your production SMS API credentials
# Sign up at: https://africastalking.com/
SMS_API_KEY=YOUR_PRODUCTION_API_KEY_HERE
SMS_USERNAME=YOUR_PRODUCTION_USERNAME_HERE
SMS_SENDER_ID=LIBRARY

# ==============================================
# File Upload Configuration
# ==============================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# ==============================================
# Pagination Defaults
# ==============================================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# ==============================================
# Library Policies
# ==============================================
MAX_BOOKS_PER_USER=3
LOAN_PERIOD_DAYS=14
FINE_PER_DAY=10
MAX_RENEWAL_TIMES=2

# ==============================================
# Client URL (Frontend)
# ==============================================
# ⚠️ IMPORTANT: Update with your production domain
CLIENT_URL=https://yourdomain.com

# ==============================================
# Security Settings (Production)
# ==============================================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
ENABLE_CORS=true
CORS_ORIGIN=https://yourdomain.com

# ==============================================
# MongoDB Credentials (Optional Override)
# ==============================================
# If you want to change MongoDB credentials in docker-compose.yml
# MONGO_ROOT_USERNAME=admin
# MONGO_ROOT_PASSWORD=your_secure_password_here

# ==============================================
# Logging (Production)
# ==============================================
LOG_LEVEL=info
DEBUG=false
